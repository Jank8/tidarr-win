{
  "name": "tidarr-main",
  "private": true,
  "workspaces": [
    "api",
    "app"
  ],
  "devDependencies": {
    "concurrently": "^10.0.0",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "app-build": "cd app && npx vite build",
    "api-build": "cd api && npx tsc --project ./tsconfig.json",
    "dev": "concurrently -n api,front \"npm exec -- tsx --watch ./api/index.ts\" \"npm run front\"",
    "front": "cd app && npm exec -- vite dev",
    "prod": "node ./api/dist/index.js"
  },
  "resolutions": {
    "minimatch": ">=10.2.3",
    "flatted": ">=3.4.0",
    "dompurify": ">=3.4.0"
  }
}
