{
  "name": "tidarr-main",
  "private": true,
  "workspaces": [
    "api",
    "app",
    "e2e"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "scripts": {
    "app-build": "cd app && npx vite build",
    "api-build": "cd api && npx tsc --project ./tsconfig.json",
    "dev": "concurrently -n api,front \"npx tsx --watch ./api/index.ts\" \"npm run front\"",
    "front": "cd app && npx vite dev",
    "prod": "node ./api/dist/index.js",
    "eslint": "eslint .",
    "eslint-fix": "eslint --fix .",
    "find-deadcode": "ts-prune | (! grep -v 'used in module')"
  },
  "resolutions": {
    "minimatch": ">=10.2.3",
    "flatted": ">=3.4.0",
    "dompurify": ">=3.4.0"
  }
}
