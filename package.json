{
  "name": "tidarr-main",
  "version": "1.1.13",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "app-build": "pnpm --filter tidarr-react build",
    "api-build": "pnpm --filter tidarr-api build",
    "dev": "node ./node_modules/concurrently/dist/bin/index.js -n api,front \"node ./node_modules/tsx/dist/cli.mjs watch --exclude=./node_modules/** --exclude=./userfiles/** ./api/index.ts\" \"node ./app/node_modules/vite/bin/vite.js dev ./app\"",
    "prod": "node ./api/dist/index.js",
    "lint": "oxlint -c .oxlintrc.json .",
    "lint-fix": "oxlint -c .oxlintrc.json --fix ."
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "shell-quote": "1.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": ">=5.0.1",
      "dompurify": ">=3.4.17",
      "linkify-it": ">=5.0.1",
      "minimatch": ">=10.2.3",
      "shell-quote": ">=1.11.0"
    }
  }
}
